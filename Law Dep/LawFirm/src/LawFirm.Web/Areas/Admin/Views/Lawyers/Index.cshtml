@model List<Lawyer>
@{
    ViewData["Title"] = "Attorneys";
}

<div class="page-head">
    <h1>Attorneys</h1>
    <a class="btn" asp-action="Create">Add attorney</a>
</div>

@if (!Model.Any())
{
    <p class="empty">No attorneys yet. Add the first one to show them on the website.</p>
}
else
{
    <div class="table-wrap">
        <table>
            <thead><tr><th>Name</th><th>Title</th><th>Practice areas</th><th>Actions</th></tr></thead>
            <tbody>
                @foreach (var l in Model)
                {
                    <tr>
                        <td>@l.FullName<br /><span class="meta">@l.Email</span></td>
                        <td>@l.Title</td>
                        <td>@string.Join(", ", l.PracticeAreas.Select(a => a.Name))</td>
                        <td class="actions">
                            <a class="btn btn-small btn-ghost" asp-action="Edit" asp-route-id="@l.Id">Edit</a>
                            <form asp-action="Delete" asp-route-id="@l.Id" method="post" data-confirm="Remove @l.FullName from the website?">
                                <button type="submit" class="btn btn-small btn-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
